model := "credit_risk.joblib"
target := risk_score

minimum_debt_ratio := 0.0
maximum_debt_ratio := 1.0
minimum_late_payments := 0.0
maximum_late_payments := 5.0
maximum_allowed_risk := 1.11
manual_review_threshold := 1.0

[BOUND]:
forall applicant
    with domain(
        applicant.debt_ratio: [minimum_debt_ratio, maximum_debt_ratio],
        applicant.late_payments: [minimum_late_payments, maximum_late_payments]
    )
    => target <= maximum_allowed_risk
    using Z3

[LOGIC]:
forall applicant
    with domain(
        applicant.debt_ratio: [minimum_debt_ratio, maximum_debt_ratio],
        applicant.late_payments: [minimum_late_payments, maximum_late_payments]
    )
    => target < manual_review_threshold
    using Z3

[LOGIC]:
exists applicant
    with domain(
        applicant.debt_ratio: [minimum_debt_ratio, maximum_debt_ratio],
        applicant.late_payments: [minimum_late_payments, maximum_late_payments]
    )
    => target >= manual_review_threshold
    using Z3
