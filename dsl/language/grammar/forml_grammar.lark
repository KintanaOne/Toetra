%import common.WS
%import common.WS_INLINE
%import common.NEWLINE
%import common.ESCAPED_STRING
%import common.NUMBER
%import common.DIGIT
%import common.CNAME -> IDENTIFIER
%ignore WS_INLINE


# === COMMENTS ===

COMMENT_LINE : /#[^\n]*/
COMMENT_BLOCK : /'''(.|\n)*?'''/
%ignore COMMENT_LINE
%ignore COMMENT_BLOCK
%ignore NEWLINE


# === PROTECTED_WORDS ===

IN.10 : "in"
WITH.10 : "with"
AT.10 : "at"
CHECK_AT.10 : "check_at"
USING.10 : "using"
MODEL.10 : "model"
TARGET.10 : "target"
NEIGHBORHOOD.10 : "neighborhood"
DATASET.10 : "dataset"


# === PROBLEMS ===

CLASSIFICATION : "CLASSIFICATION"
PREDICTION : "PREDICTION"
REGRESSION : "REGRESSION"
CLUSTERING : "CLUSTERING"
ANOMALY_DETECTION : "ANOMALY_DETECTION"
REINFORCEMENT_LEARNING : "REINFORCEMENT_LEARNING"


# === PROPERTIES ===

ROBUSTNESS : "ROBUSTNESS"
STABILITY : "STABILITY"
FAIRNESS : "FAIRNESS"
MONOTONICITY : "MONOTONICITY"
BOUND : "BOUND"
LOGIC : "LOGIC"


# === QUANTIFIERS ===

FORALL : "∀"
EXIST : "∃"
FORALL_WORD : "forall"
EXISTS_WORD : "exists"


# === FUNCTIONS ===

EQUAL : "EQUAL"
EQUITY : "EQUITY"
BETWEEN : "BETWEEN"
INCREASING : "INCREASING"
DECREASING : "DECREASING"


# === BACKENDS ===

z3 : "z3"
Z3 : "Z3"
eran : "eran"
ERAN : "ERAN"
zonotope : "zonotope"
ZONOTOPE : "ZONOTOPE"
box : "box"
BOX : "BOX"


# === METRICS ===

L1 : "L1"
L2 : "L2"
LINF : "Linf"


# === LOGIC_OPERATIONS ===

AND : "and"
OR : "or"
NOT : "not"
XOR : "xor"
IMPLY : "->"


# === COMPARISON_OPERATORS ===

EQ : "=="
NEQ : "!="
LT : "<"
LTE : "<="
GT : ">"
GTE : ">="


# === TOKENS ===

PAIRWISE.2 : /[A-Za-z][A-Za-z0-9_]*\s*~\s*[A-Za-z][A-Za-z0-9_']*/
PROPERTY_IMPLY : "=>"


# === BASIC CHARACTER DEFINITIONS ===

CHAR : /[a-zA-Z]/
string : ESCAPED_STRING

# === BASIC VALUE TYPES ===

true : "True"
    | "true"
false : "False"
    | "false"
boolean : true
    | false

# === IDENTIFIERS ===

identifier : IDENTIFIER
quoted_identifier : ESCAPED_STRING
    | identifier

# === VALUE TYPES ===

value_number : NUMBER
value_boolean : boolean
value : value_number
    | value_boolean
    | string

# === ARGUMENTS ===

arg_identifier_eq : quoted_identifier "=" value
arg_identifier_only : quoted_identifier
arg_number : NUMBER
arg_boolean : boolean
arg : arg_identifier_eq
    | arg_identifier_only
    | arg_number
    | arg_boolean
args : arg ("," arg)*

# === NEWLINES ===

NEWLINE_SEQUENCE : NEWLINE (NEWLINE)*

# === PADDING ===

padding : (NEWLINE_SEQUENCE)*

# =========================================================
# === LOGIC (NON-ROBUSTNESS) ==============================
# =========================================================
# === LOGIC OPERATIONS ===

logic_operation : AND
    | OR
    | NOT
    | XOR
    | IMPLY
comparison_operation : EQ
    | NEQ
    | LT
    | LTE
    | GT
    | GTE

# === FUNCTIONS / PROBLEMS ===

function : EQUAL
    | EQUITY
    | BETWEEN
    | INCREASING
    | DECREASING
function_expr : function "(" (args)? ")"
problem_expr : (CLASSIFICATION
    | PREDICTION
    | REGRESSION
    | CLUSTERING
    | ANOMALY_DETECTION
    | REINFORCEMENT_LEARNING) "." function_expr

# === ATTRIBUTES ===

attribute_identifier : identifier
    | TARGET
attribute : identifier ("." attribute_identifier)*
logic_expr : attribute logic_operation value
comparison_expr : attribute comparison_operation value

# === ASSERTION ===

?assertion : logic_imply
?logic_imply : logic_or
    | logic_or "->" logic_imply -> logical_imply
?logic_or : logic_and
    | logic_or "OR" logic_and -> logic_or
?logic_and : logic_not
    | logic_and "AND" logic_not -> logic_and
?logic_not : "NOT" atom -> logic_not
    | atom
?atom : comparison_expr
    | logic_expr
    | problem_expr
    | "(" assertion ")"

# =========================================================
# === ROBUSTNESS CORE =====================================
# =========================================================
# === NEIGHBORHOOD (CRITICAL ABSTRACTION) ===

neighborhood : IN NEIGHBORHOOD "(" ("metric" "=")? (L1
    | L2
    | LINF) "," (args)? ")"

# =========================================================
# === PROPERTY EXPRESSIONS ================================
# =========================================================

property_expr : quantifier_expr
    | at_expr
    | check_expr
    | pairwise_expr

# =========================================================
# === QUANTIFIER ==========================================
# =========================================================

quantifier : FORALL
    | EXIST
    | FORALL_WORD
    | EXISTS_WORD
quantifier_expr : quantifier (domain)?

# =========================================================
# === AT (POINTWISE) ======================================
# =========================================================

at_expr : AT identifier (neighborhood)? (domain)?

# Exemple : at x0 in hyperball(x0, L2, 0.01)
# =========================================================
# === CHECK AT (POINTWISE) ================================
# =========================================================

check_expr : CHECK_AT identifier

# =========================================================
# === PAIRWISE (ROBUSTNESS) ===============================
# =========================================================

pairwise_token : PAIRWISE
pairwise_expr : pairwise_token neighborhood (domain)?

# Exemple : x ~ x' in hyperball(x, L2, 0.01)
# =========================================================
# === DOMAIN / CONTEXT ====================================
# =========================================================

domain : WITH identifier "(" value ("," value)* ")"

# =========================================================
# === PROPERTY DEFINITION =================================
# =========================================================

property_imply : PROPERTY_IMPLY
property_type : ROBUSTNESS
    | STABILITY
    | FAIRNESS
    | MONOTONICITY
    | BOUND
    | LOGIC
    | /[A-Z]+/
property : "[" property_type "]" ":" padding property_expr padding property_imply padding assertion (backend)?
property_section : property

# =========================================================
# === BACKEND =============================================
# =========================================================

backend : USING (z3
    | Z3
    | eran
    | ERAN
    | zonotope
    | ZONOTOPE
    | box
    | BOX) ("(" args ")")?

# =========================================================
# === DECLARATIONS ========================================
# =========================================================

target_declaration : TARGET ":=" identifier
model : quoted_identifier
model_declaration : MODEL ":=" model
dataset : quoted_identifier
dataset_declaration : DATASET ":=" dataset
variable_declaration : identifier ":=" value
variables_declaration : variable_declaration (";" variable_declaration)*

# =========================================================
# === PROGRAM STRUCTURE ===================================
# =========================================================

header : padding model_declaration padding target_declaration padding (dataset_declaration padding)? (variables_declaration padding)?
body : padding property_section (padding property_section)* padding
program : header body