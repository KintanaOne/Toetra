%import common.WS
%import common.WS_INLINE
%import common.NEWLINE
%import common.ESCAPED_STRING
%import common.NUMBER
%import common.DIGIT
%import common.CNAME -> IDENTIFIER
%ignore WS_INLINE


# === COMMENTS ===

COMMENT_LINE : /#[^\n]*/
COMMENT_BLOCK : /'''(.|\n)*?'''/
%ignore COMMENT_LINE
%ignore COMMENT_BLOCK
%ignore NEWLINE
%ignore NEWLINE_SEQUENCE


# === PROTECTED_WORDS ===

IN.10 : /in(?![A-Za-z0-9_])/
WITH.10 : /with(?![A-Za-z0-9_])/
DOMAIN.10 : /domain(?![A-Za-z0-9_])/
AT.10 : /at(?![A-Za-z0-9_])/
CHECK_AT.10 : /check_at(?![A-Za-z0-9_])/
USING.10 : /using(?![A-Za-z0-9_])/
MODEL.10 : /model(?![A-Za-z0-9_])/
TARGET.10 : /target(?![A-Za-z0-9_])/
NEIGHBORHOOD.10 : /neighborhood(?![A-Za-z0-9_])/
DATASET.10 : /dataset(?![A-Za-z0-9_])/
TRUE.10 : /(?:True|true)(?![A-Za-z0-9_])/
FALSE.10 : /(?:False|false)(?![A-Za-z0-9_])/


# === PROBLEMS ===

CLASSIFICATION : "CLASSIFICATION"
PREDICTION : "PREDICTION"
REGRESSION : "REGRESSION"
CLUSTERING : "CLUSTERING"
ANOMALY_DETECTION : "ANOMALY_DETECTION"
REINFORCEMENT_LEARNING : "REINFORCEMENT_LEARNING"


# === PROPERTIES ===

ROBUSTNESS : "ROBUSTNESS"
STABILITY : "STABILITY"
FAIRNESS : "FAIRNESS"
MONOTONICITY : "MONOTONICITY"
BOUND : "BOUND"
LOGIC : "LOGIC"


# === QUANTIFIERS ===

FORALL : "∀"
EXIST : "∃"
FORALL_WORD : "forall"
EXISTS_WORD : "exists"


# === FUNCTIONS ===

EQUAL : "EQUAL"
EQUITY : "EQUITY"
BETWEEN : "BETWEEN"
INCREASING : "INCREASING"
DECREASING : "DECREASING"


# === BACKENDS ===

z3 : "z3"
Z3 : "Z3"
eran : "eran"
ERAN : "ERAN"
zonotope : "zonotope"
ZONOTOPE : "ZONOTOPE"
box : "box"
BOX : "BOX"


# === METRICS ===

L1 : "L1"
L2 : "L2"
LINF : "Linf"


# === LOGIC_OPERATIONS ===

AND : "and"
OR : "or"
NOT : "not"
XOR : "xor"
IMPLY : "->"


# === COMPARISON_OPERATORS ===

EQ : "=="
NEQ : "!="
LT : "<"
LTE : "<="
GT : ">"
GTE : ">="


# === ARITHMETIC_OPERATORS ===

PLUS : "+"
MINUS : "-"
STAR : "*"
SLASH : "/"


# === TOKENS ===

PAIRWISE.2 : /[A-Za-z][A-Za-z0-9_]*\s*~\s*[A-Za-z][A-Za-z0-9_']*/
PROPERTY_IMPLY : "=>"


# === BASIC CHARACTER DEFINITIONS ===

CHAR : /[a-zA-Z]/
string : ESCAPED_STRING

# === BASIC VALUE TYPES ===

true : TRUE
false : FALSE
boolean : true
    | false

# === IDENTIFIERS ===

identifier : IDENTIFIER
quoted_identifier : ESCAPED_STRING
    | identifier

# === VALUE TYPES ===

value_number : NUMBER
value_boolean : boolean
value : value_number
    | value_boolean
    | string

# Specification constants accept signed numeric literals only.

numeric_literal_sign : PLUS
    | MINUS
signed_number_literal : (numeric_literal_sign)? NUMBER
specification_constant_literal : signed_number_literal
    | value_boolean
    | string

# === ARGUMENTS ===

arg_identifier_eq : quoted_identifier "=" value
arg_identifier_only : quoted_identifier
arg_number : NUMBER
arg_boolean : boolean
arg : arg_identifier_eq
    | arg_identifier_only
    | arg_number
    | arg_boolean
args : arg ("," arg)*

# === NEWLINES ===

NEWLINE_SEQUENCE : NEWLINE (NEWLINE)*

# === PADDING ===

padding : (NEWLINE_SEQUENCE)*

# =========================================================
# === LOGIC AND SCALAR EXPRESSIONS ========================
# =========================================================
# === LOGIC OPERATIONS ===

logic_operation : AND
    | OR
    | NOT
    | XOR
    | IMPLY
comparison_operation : EQ
    | NEQ
    | LT
    | LTE
    | GT
    | GTE

# === FUNCTIONS / PROBLEMS ===

function : EQUAL
    | EQUITY
    | BETWEEN
    | INCREASING
    | DECREASING
function_expr : function "(" (args)? ")"
problem_expr : (CLASSIFICATION
    | PREDICTION
    | REGRESSION
    | CLUSTERING
    | ANOMALY_DETECTION
    | REINFORCEMENT_LEARNING) "." function_expr

# === ATTRIBUTES / MODEL OUTPUT ===

attribute : identifier ("." identifier)*
target_ref : TARGET

# === SCALAR ARITHMETIC ===

additive_operator : PLUS
    | MINUS
multiplicative_operator : STAR
    | SLASH
unary_operator : PLUS
    | MINUS
scalar_expression : additive_expr
additive_expr : multiplicative_expr (additive_operator multiplicative_expr)*
multiplicative_expr : unary_expr (multiplicative_operator unary_expr)*
unary_expr : unary_operator unary_expr
    | scalar_primary
scalar_primary : value
    | target_ref
    | attribute
    | parenthesized_scalar
parenthesized_scalar : "(" scalar_expression ")"
logic_expr : attribute logic_operation value
comparison_expr : scalar_expression comparison_operation scalar_expression

# === ASSERTION ===

?assertion : logic_imply
?logic_imply : logic_or
    | logic_or "->" logic_imply -> logical_imply
?logic_or : logic_and
    | logic_or "OR" logic_and -> logic_or
?logic_and : logic_not
    | logic_and "AND" logic_not -> logic_and
?logic_not : "NOT" atom -> logic_not
    | atom
?atom : comparison_expr
    | logic_expr
    | problem_expr
    | "(" assertion ")"

# =========================================================
# === ROBUSTNESS CORE =====================================
# =========================================================
# === NEIGHBORHOOD (CRITICAL ABSTRACTION) ===

neighborhood : IN NEIGHBORHOOD "(" ("metric" "=")? (L1
    | L2
    | LINF) "," (args)? ")"

# =========================================================
# === PROPERTY EXPRESSIONS ================================
# =========================================================

property_expr : quantifier_expr
    | at_expr
    | check_expr
    | pairwise_expr

# =========================================================
# === QUANTIFIER ==========================================
# =========================================================

quantifier : FORALL
    | EXIST
    | FORALL_WORD
    | EXISTS_WORD
quantifier_expr : quantifier identifier (padding domain)?

# =========================================================
# === AT (LOCAL) ==========================================
# =========================================================

at_expr : AT identifier (padding neighborhood)? (padding domain)?

# =========================================================
# === CHECK AT (POINTWISE) ================================
# =========================================================

check_expr : CHECK_AT identifier

# =========================================================
# === PAIRWISE (ROBUSTNESS) ===============================
# =========================================================

pairwise_token : PAIRWISE
pairwise_expr : pairwise_token padding neighborhood (padding domain)?

# =========================================================
# === DOMAIN / CONTEXT ====================================
# =========================================================

domain : WITH DOMAIN "(" padding domain_entry (padding "," padding domain_entry)* (padding ",")? padding ")"
domain_entry : attribute ":" domain_constraint
domain_constraint : interval_domain
    | finite_set_domain
interval_domain : closed_closed_interval
    | open_closed_interval
    | closed_open_interval
    | open_open_interval
closed_closed_interval : "[" padding scalar_expression padding "," padding scalar_expression padding "]"
open_closed_interval : "]" padding scalar_expression padding "," padding scalar_expression padding "]"
closed_open_interval : "[" padding scalar_expression padding "," padding scalar_expression padding "["
open_open_interval : "]" padding scalar_expression padding "," padding scalar_expression padding "["
symbolic_literal : identifier
finite_set_value : value
    | symbolic_literal
finite_set_domain : "{" padding finite_set_value (padding "," padding finite_set_value)* (padding ",")? padding "}"

# =========================================================
# === PROPERTY DEFINITION =================================
# =========================================================

property_imply : PROPERTY_IMPLY
property_type : ROBUSTNESS
    | STABILITY
    | FAIRNESS
    | MONOTONICITY
    | BOUND
    | LOGIC
    | /[A-Z]+/
property : "[" property_type "]" ":" padding property_expr padding property_imply padding assertion (padding backend)?
property_section : property

# =========================================================
# === BACKEND =============================================
# =========================================================

backend : USING (z3
    | Z3
    | eran
    | ERAN
    | zonotope
    | ZONOTOPE
    | box
    | BOX) ("(" args ")")?

# =========================================================
# === DECLARATIONS ========================================
# =========================================================

target_declaration : TARGET ":=" identifier
model : quoted_identifier
model_declaration : MODEL ":=" model
dataset : quoted_identifier
dataset_declaration : DATASET ":=" dataset
specification_constant_declaration : identifier ":=" specification_constant_literal
specification_constants : specification_constant_declaration ((";")? specification_constant_declaration)* (";")?

# =========================================================
# === PROGRAM STRUCTURE ===================================
# =========================================================

header : padding model_declaration padding target_declaration padding (dataset_declaration padding)? (specification_constants padding)?
body : padding property_section (padding property_section)* padding
program : header body