(* === BASIC CHARACTER DEFINITIONS === *)
CHAR = ? CHAR ?;
string = ? escaped_string ? ;

(* === BASIC VALUE TYPES === *)
true  = TRUE ;
false = FALSE ;
boolean = true | false ;

(* === IDENTIFIERS === *)
identifier = ? identifier_name ? ;
quoted_identifier = ? escaped_string ? | identifier | ? argument_keywords ? ;

(* === VALUE TYPES === *)
value_number = ? number ? ;
value_boolean = boolean ;
value = value_number | value_boolean | string ;

(* Specification constants accept signed numeric literals only. *)
numeric_literal_sign = ? arithmetic_unary_operators ? ;
signed_number_literal = [ numeric_literal_sign ] , ? number ? ;
specification_constant_literal = signed_number_literal | value_boolean | string ;

(* === ARGUMENTS === *)
arg_identifier_eq   = quoted_identifier , "=" , value ;
arg_identifier_only = quoted_identifier ;
arg_number          = ? number ? ;
arg_boolean         = boolean ;

arg  = arg_identifier_eq | arg_identifier_only | arg_number | arg_boolean ;
args = arg , { "," , arg } ;

(* === NEWLINES === *)
NEWLINE_SEQUENCE = NEWLINE , { NEWLINE } ;

(* === PADDING === *)
padding = { NEWLINE_SEQUENCE } ;

(* ========================================================= *)
(* === LOGIC AND SCALAR EXPRESSIONS ======================== *)
(* ========================================================= *)

(* === LOGIC OPERATIONS === *)
logic_operation = ? official_logic_operators ? ;
comparison_operation = ? comparison_operators ? ;

(* === FUNCTIONS / PROBLEMS === *)
function        = ? official_functions ? ;
function_expr   = function , "(" , [ args ] , ")" ;
problem_expr    = ( ? official_problems ? ) , "." , function_expr ;

(* === ATTRIBUTES / MODEL OUTPUT === *)
attribute = identifier , { "." , identifier } ;
model_output_ref = TARGET , [ "[" , identifier , "]" ] ;
target_ref = model_output_ref ;
predicted_label_observable = "label" ;
class_label_literal = specification_constant_literal ;
class_probability_observable = "probability" , "(" , class_label_literal , ")" ;
output_observable = model_output_ref , "." , ( predicted_label_observable | class_probability_observable ) ;

(* === SCALAR ARITHMETIC === *)
additive_operator = ? arithmetic_additive_operators ? ;
multiplicative_operator = ? arithmetic_multiplicative_operators ? ;
unary_operator = ? arithmetic_unary_operators ? ;

scalar_expression = additive_expr ;
additive_expr = multiplicative_expr , { additive_operator , multiplicative_expr } ;
multiplicative_expr = unary_expr , { multiplicative_operator , unary_expr } ;
unary_expr = unary_operator , unary_expr | scalar_primary ;
scalar_primary = value | output_observable | target_ref | attribute | parenthesized_scalar ;
parenthesized_scalar = "(" , scalar_expression , ")" ;

logic_expr = attribute , logic_operation , value ;
comparison_expr = scalar_expression , comparison_operation , scalar_expression ;

(* === ASSERTION === *)

?assertion      = logic_imply

?logic_imply    = logic_or | logic_or "->" logic_imply          -> logical_imply

?logic_or       = logic_and | logic_or ( OR | "OR" ) logic_and           -> logic_or

?logic_and      = logic_not | logic_and ( AND | "AND" ) logic_not         -> logic_and

?logic_not      = ( NOT | "NOT" ) atom                                    -> logic_not | atom

?atom           = comparison_expr | logic_expr | problem_expr | "(" assertion ")"

(* ========================================================= *)
(* === ROBUSTNESS CORE ===================================== *)
(* ========================================================= *)

(* === NEIGHBORHOOD (CRITICAL ABSTRACTION) === *)
neighborhood = IN , NEIGHBORHOOD , "(" , [ ARG_METRIC , "=" ] , ( ? official_metrics ? ) , "," , [ args ] , ")" ;
neighborhood_of_argument = ARG_OF , "=" , identifier ;
neighborhood_metric_argument = ARG_METRIC , "=" , ( ? official_metrics ? ) ;
neighborhood_eps_argument = ARG_EPS , "=" , scalar_expression ;
neighborhood_membership = identifier , IN , NEIGHBORHOOD , "(" , neighborhood_of_argument , "," , neighborhood_metric_argument , "," , neighborhood_eps_argument , ")" ;
local_neighborhood = LOCAL_WITH , identifier , IN , NEIGHBORHOOD , "(" , neighborhood_metric_argument , "," , neighborhood_eps_argument , ")" ;

(* ========================================================= *)
(* === PROPERTY EXPRESSIONS ================================ *)
(* ========================================================= *)

property_expr = quantifier_expr | at_expr | check_expr | pairwise_expr ;

(* ========================================================= *)
(* === QUANTIFIER ========================================== *)
(* ========================================================= *)

quantifier = ? official_quantifier ? ;
quantifier_clause = quantifier , identifier , { "," , identifier } ;
quantifier_expr = quantifier , identifier , { "," , identifier } , { padding , quantifier_clause } , [ padding , domain ] , [ padding , where_clause ] ;

(* ========================================================= *)
(* === AT (LOCAL) ========================================== *)
(* ========================================================= *)

legacy_at_suffix = padding , neighborhood , [ padding , domain ] | padding , domain ;
at_suffix = local_neighborhood | legacy_at_suffix ;
at_expr = AT , identifier , [ at_suffix ] ;

(* ========================================================= *)
(* === CHECK AT (POINTWISE) ================================ *)
(* ========================================================= *)

check_expr = CHECK_AT , identifier ;

(* ========================================================= *)
(* === PAIRWISE (ROBUSTNESS) =============================== *)
(* ========================================================= *)

pairwise_token = PAIRWISE ;
pairwise_expr = pairwise_token , padding , neighborhood , [ padding , domain ] ;

(* ========================================================= *)
(* === RESTRICTIONS ======================================== *)
(* ========================================================= *)

restriction = neighborhood_membership | assertion ;
where_clause = WHERE , restriction ;

(* ========================================================= *)
(* === DOMAIN / CONTEXT ==================================== *)
(* ========================================================= *)

domain = WITH , DOMAIN , "(" , padding , domain_entry , { padding , "," , padding , domain_entry } , [ padding , "," ] , padding , ")" ;
domain_entry = attribute , ":" , domain_constraint ;
domain_constraint = interval_domain | finite_set_domain ;

interval_domain = closed_closed_interval | open_closed_interval | closed_open_interval | open_open_interval ;
closed_closed_interval = "[" , padding , scalar_expression , padding , "," , padding , scalar_expression , padding , "]" ;
open_closed_interval = "]" , padding , scalar_expression , padding , "," , padding , scalar_expression , padding , "]" ;
closed_open_interval = "[" , padding , scalar_expression , padding , "," , padding , scalar_expression , padding , "[" ;
open_open_interval = "]" , padding , scalar_expression , padding , "," , padding , scalar_expression , padding , "[" ;

symbolic_literal = identifier ;
finite_set_value = value | symbolic_literal ;
finite_set_domain = "{" , padding , finite_set_value , { padding , "," , padding , finite_set_value } , [ padding , "," ] , padding , "}" ;

(* ========================================================= *)
(* === PROPERTY DEFINITION ================================= *)
(* ========================================================= *)

property_imply = PROPERTY_IMPLY ;
property_type = ? official_properties ? | ? uppercase_string ? ;
property = "[" , property_type , "]" , ":" , padding , ( property_expr , padding , property_imply , padding , assertion | assertion ) , [ padding , backend ] ;
property_section = property ;

(* ========================================================= *)
(* === BACKEND ============================================= *)
(* ========================================================= *)

backend = USING , ( ? official_backends ? ) , [ "(" , args , ")" ] ;

(* ========================================================= *)
(* === DECLARATIONS ======================================== *)
(* ========================================================= *)

target_declaration = TARGET , ":=" , identifier ;
model = quoted_identifier ;
model_declaration = MODEL , ":=" , model ;
dataset = quoted_identifier ;
dataset_declaration = DATASET , ":=" , dataset ;
specification_constant_declaration = identifier , ":=" , specification_constant_literal ;
specification_constants = specification_constant_declaration , { [ ";" ] , specification_constant_declaration } , [ ";" ] ;

anchor_literal = specification_constant_literal ;
anchor_entry = identifier , ":" , anchor_literal ;
inline_anchor = "{" , padding , anchor_entry , { padding , "," , padding , anchor_entry } , [ padding , "," ] , padding , "}" ;
anchor_ref_key_argument = ARG_KEY , "=" , value ;
anchor_ref_value_argument = ARG_VALUE , "=" , value ;
anchor_ref_argument = anchor_ref_key_argument | anchor_ref_value_argument ;
anchor_ref = REF , "(" , padding , anchor_ref_argument , { padding , "," , padding , anchor_ref_argument } , [ padding , "," ] , padding , ")" ;
anchor_binding = inline_anchor | anchor_ref ;
anchor_declaration = ANCHOR , identifier , ":=" , anchor_binding ;
anchor_declarations = anchor_declaration , { [ ";" ] , anchor_declaration } , [ ";" ] ;

(* ========================================================= *)
(* === PROGRAM STRUCTURE =================================== *)
(* ========================================================= *)

header = padding , model_declaration , padding , target_declaration , padding , [ dataset_declaration , padding ] , [ specification_constants , padding ] , [ anchor_declarations , padding ] ;
body = padding , property_section , { padding , property_section } , padding ;
program = header , body ;
