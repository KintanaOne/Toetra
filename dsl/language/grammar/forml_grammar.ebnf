(* === BASIC CHARACTER DEFINITIONS === *)
CHAR = ? CHAR ?;
string = ? escaped_string ? ;

(* === BASIC VALUE TYPES === *)
true  = "True" | "true" ;
false = "False" | "false" ;
boolean = true | false ;

(* === IDENTIFIERS === *)
identifier = ? identifier_name ? ;
quoted_identifier = ? escaped_string ? | identifier ;

(* === VALUE TYPES === *)
value_number = ? number ? ;
value_boolean = boolean ;
value = value_number | value_boolean | string ;

(* === ARGUMENTS === *)
arg_identifier_eq   = quoted_identifier , "=" , value ;
arg_identifier_only = quoted_identifier ;
arg_number          = ? number ? ;
arg_boolean         = boolean ;

arg  = arg_identifier_eq | arg_identifier_only | arg_number | arg_boolean ;
args = arg , { "," , arg } ;


(* === NEWLINES === *)
NEWLINE_SEQUENCE = NEWLINE , { NEWLINE } ;

(* === PADDING === *)
padding = { NEWLINE_SEQUENCE } ;

(* ========================================================= *)
(* === LOGIC (NON-ROBUSTNESS) ============================== *)
(* ========================================================= *)

(* === LOGIC OPERATIONS === *)
logic_operation = ? official_logic_operators ? ;
comparison_operation = ? comparison_operators ? ;

(* === FUNCTIONS / PROBLEMS === *)
function        = ? official_functions ? ;
function_expr   = function , "(" , [ args ] , ")" ;
problem_expr    = ( ? official_problems ? ) , "." , function_expr ;

(* === ATTRIBUTES / MODEL OUTPUT === *)
attribute = identifier , { "." , identifier } ;

target_comparison_expr = TARGET , comparison_operation , value ;
attribute_comparison_expr = attribute , comparison_operation , value ;

logic_expr = attribute , logic_operation , value ;
comparison_expr = target_comparison_expr | attribute_comparison_expr ;

(* === ASSERTION === *)

?assertion      = logic_imply

?logic_imply    = logic_or | logic_or "->" logic_imply          -> logical_imply

?logic_or       = logic_and | logic_or "OR" logic_and           -> logic_or

?logic_and      = logic_not | logic_and "AND" logic_not         -> logic_and

?logic_not      = "NOT" atom                                    -> logic_not | atom

?atom           = comparison_expr | logic_expr | problem_expr | "(" assertion ")"

(* ========================================================= *)
(* === ROBUSTNESS CORE ===================================== *)
(* ========================================================= *)

(* === NEIGHBORHOOD (CRITICAL ABSTRACTION) === *)
neighborhood = IN , NEIGHBORHOOD , "(" , [ "metric" , "=" ] , ( ? official_metrics ? ) , "," , [ args ] , ")" ;

(* ========================================================= *)
(* === PROPERTY EXPRESSIONS ================================ *)
(* ========================================================= *)

property_expr = quantifier_expr | at_expr | check_expr | pairwise_expr ;

(* ========================================================= *)
(* === QUANTIFIER ========================================== *)
(* ========================================================= *)

quantifier = ? official_quantifier ? ;

quantifier_expr = quantifier , [ domain ] ;


(* ========================================================= *)
(* === AT (POINTWISE) ====================================== *)
(* ========================================================= *)

at_expr = AT , identifier , [ neighborhood ] , [ domain ] ;

(* Exemple : at x0 in hyperball(x0, L2, 0.01) *)

(* ========================================================= *)
(* === CHECK AT (POINTWISE) ================================ *)
(* ========================================================= *)

check_expr = CHECK_AT , identifier ;

(* ========================================================= *)
(* === PAIRWISE (ROBUSTNESS) =============================== *)
(* ========================================================= *)

pairwise_token = PAIRWISE ;
pairwise_expr = pairwise_token , neighborhood , [ domain ] ;

(* Exemple : x ~ x' in hyperball(x, L2, 0.01) *)

(* ========================================================= *)
(* === DOMAIN / CONTEXT ==================================== *)
(* ========================================================= *)

domain = WITH , identifier , "(" , value , { "," , value } , ")" ;

(* ========================================================= *)
(* === PROPERTY DEFINITION ================================= *)
(* ========================================================= *)

property_imply = PROPERTY_IMPLY ;

property_type = ? official_properties ? | ? uppercase_string ? ;

property = "[" , property_type , "]" , ":" , padding , property_expr , padding , property_imply , padding , assertion , [ backend ] ;
property_section = property ;

(* ========================================================= *)
(* === BACKEND ============================================= *)
(* ========================================================= *)

backend = USING , ( ? official_backends ? ) , [ "(" , args , ")" ] ;

(* ========================================================= *)
(* === DECLARATIONS ======================================== *)
(* ========================================================= *)

target_declaration = TARGET , ":=" , identifier ;

model = quoted_identifier ;

model_declaration = MODEL , ":=" , model ;

dataset = quoted_identifier ;

dataset_declaration = DATASET , ":=" , dataset ;

variable_declaration = identifier , ":=" , value ;

variables_declaration = variable_declaration , { ";" , variable_declaration } ;

(* ========================================================= *)
(* === PROGRAM STRUCTURE =================================== *)
(* ========================================================= *)

header = padding , model_declaration , padding , target_declaration , padding , [ dataset_declaration , padding ] , [ variables_declaration , padding ] ;

body = padding , property_section , { padding , property_section } , padding ;

program = header , body ;