%import common.WS
%import common.WS_INLINE
%import common.NEWLINE
%import common.ESCAPED_STRING
%import common.NUMBER
%import common.DIGIT
%import common.CNAME -> IDENTIFIER
%ignore WS_INLINE
COMMENT_LINE: /#[^\n]*/
COMMENT_BLOCK: /'''(.|\n)*?'''/
%ignore COMMENT_LINE
%ignore COMMENT_BLOCK
%ignore NEWLINE

# === OFFICIAL PROBLEMS ===
CLASSIFICATION : "CLASSIFICATION"
PREDICTION : "PREDICTION"
REGRESSION : "REGRESSION"
CLUSTERING : "CLUSTERING"
ANOMALY_DETECTION : "ANOMALY_DETECTION"
REINFORCEMENT_LEARNING : "REINFORCEMENT_LEARNING"

# === OFFICIAL PROPERTIES ===
ROBUSTNESS : "ROBUSTNESS"
STABILITY : "STABILITY"
FAIRNESS : "FAIRNESS"
MONOTONICITY : "MONOTONICITY"
BOUND : "BOUND"
LOGIC : "LOGIC"

# === OFFICIAL QUANTIFIER SETS ===
FORALL : "∀"
EXIST : "∃"
forall : "forall"
exist : "exist"

# === OFFICIAL FUNCTIONS ===
EQUAL : "EQUAL"
EQUITY : "EQUITY"
BETWEEN : "BETWEEN"
INCREASING : "INCREASING"
DECREASING : "DECREASING"

# === OFFICIAL BACKENDS ===
eran : "eran"
ERAN : "ERAN"
zonotope : "zonotope"
ZONOTOPE : "ZONOTOPE"
box : "box"
BOX : "BOX"
z3 : "z3"
Z3 : "Z3"

# === OFFICIAL METRICS ===
L1 : "L1"
L2 : "L2"
LINF : "Linf"

# === PROTECTED WORDS ===
IN : "in"
WITH : "with"
AT : "at"
CHECK_AT : "check_at"
USING : "using"
MODEL : "model"
TARGET : "target"
NEIGHBORHOOD : "neighborhood"
# === OFFICIAL LOGIC OPERATIONS ===
EQ : "=="
NEQ : "!="
LT : "<"
LTE : "<="
GT : ">"
GTE : ">="

# === TOKENS ===
PAIRWISE.2 : /[A-Za-z][A-Za-z0-9_]*\s*~\s*[A-Za-z][A-Za-z0-9_']*/

# === BASIC CHARACTER DEFINITIONS ===
CHAR :  /[a-zA-Z]/
string : ESCAPED_STRING

# === BASIC VALUE TYPES ===
true :  "True" | "true" 
false :  "False" | "false" 
boolean :  true | false 

# === IDENTIFIERS ===
identifier :  IDENTIFIER 
quoted_identifier :  ESCAPED_STRING | identifier 

# === VALUE TYPES ===
value_number :  NUMBER 
value_boolean :  boolean 
value :  value_number | value_boolean | string 

# === ARGUMENTS ===
arg_identifier_eq :  quoted_identifier "=" value 
arg_identifier_only :  quoted_identifier 
arg_number :  NUMBER 
arg_boolean :  boolean 

arg :  arg_identifier_eq | arg_identifier_only | arg_number | arg_boolean 
args :  arg ( "," arg )* 

# === SEPARATORS ===
SEPARATOR :  ";" 

# === NEWLINES ===
NEWLINE_SEQUENCE :  NEWLINE ( NEWLINE )* 

# === COMMENTS ===
simple_comment :  "#" /[^\n]+/ 
multiline_comment :  /'''(.|\n)*?'''/ 
comment :  simple_comment | multiline_comment 
comments :  comment ( comment )* 

# === PADDING ===
padding :  ( NEWLINE_SEQUENCE | comments )* 

# =========================================================
# === LOGIC (NON-ROBUSTNESS) ===============================
# =========================================================

# === FUNCTIONS / PROBLEMS ===
function :  ( EQUAL | EQUITY | BETWEEN | INCREASING | DECREASING ) 
function_expr :  function "(" ( args )? ")" 
problem_expr :  ( CLASSIFICATION | PREDICTION | REGRESSION | CLUSTERING | ANOMALY_DETECTION | REINFORCEMENT_LEARNING ) "." function_expr 

# === ATTRIBUTES ===
attribute :  identifier ( "." identifier )* 
logic_expr :  attribute logic_operation value 

# === LOGIC OPERATIONS ===
logic_operation :  ( EQ | NEQ | LT | LTE | GT | GTE ) 

# === IMPLICATION ===
assertion :  logic_or ( "->" assertion )? 
logic_or :  logic_and ( "OR" logic_and )* 
logic_and :  logic_not ( "AND" logic_not )* 
logic_not :  ( "NOT" )? atom 
atom :  logic_expr | problem_expr | "(" assertion ")" 

# =========================================================
# === ROBUSTNESS CORE =====================================
# =========================================================

# === NEIGHBORHOOD (CRITICAL ABSTRACTION) ===
neighborhood :  "neighborhood" "(" ( L1 | L2 | LINF ) "," ( args )? ")" 

# Exemple attendu : hyperball(x, "L2", 0.01)

# =========================================================
# === PROPERTY EXPRESSIONS ================================
# =========================================================

property_expr :  quantifier_expr | at_expr | check_expr | pairwise_expr 

# === UNIVERSAL (GLOBAL) ===
quantifier :  ( FORALL | EXIST | forall | exist ) 

quantifier_expr :  quantifier ( domain )? 

# Exemple : forall -> P() (x implicite)

# ================================== POINTWISE ==================================

# =========================================================
# === AT (POINTWISE) ======================================
# =========================================================

at_expr :  "at" identifier ( "in" neighborhood )? ( domain )? 

# Exemple : at x0 in hyperball(x0, L2, 0.01)

# =========================================================
# === CHECK AT (POINTWISE) ================================
# =========================================================

check_expr :  "check_at" identifier 

# =========================================================
# === PAIRWISE (ROBUSTNESS) ===============================
# =========================================================

pairwise_token :  PAIRWISE 
pairwise_expr :  pairwise_token "in" neighborhood 

# Exemple : x ~ x' in hyperball(x, L2, 0.01)

# =========================================================
# === DOMAIN / CONTEXT ====================================
# =========================================================

domain :  "with" identifier "(" value ( "," value )* ")" 

# =========================================================
# === PROPERTY DEFINITION =================================
# =========================================================

property_type :  ( ROBUSTNESS | STABILITY | FAIRNESS | MONOTONICITY | BOUND | LOGIC ) | /[A-Z]+/ 

property :  "[" property_type "]" ":" property_expr "->" assertion 

property_section :  property ( abstractor )? 

# =========================================================
# === ABSTRACTOR ==========================================
# =========================================================

abstractor :  "using" ( eran | ERAN | zonotope | ZONOTOPE | box | BOX | z3 | Z3 ) ( "(" args ")" )? 

# =========================================================
# === DECLARATIONS ========================================
# =========================================================

target_declaration :  "target" ":=" identifier 

model :  quoted_identifier 

model_declaration :  "model" ":=" model 

variable_declaration :  identifier ":=" value 

variables_declaration :  variable_declaration ( SEPARATOR variable_declaration )* 

# =========================================================
# === PROGRAM STRUCTURE ===================================
# =========================================================

header :  padding model_declaration padding target_declaration padding ( variables_declaration padding )? 

body :  padding property_section ( SEPARATOR padding property_section )* ( SEPARATOR )? padding 

program :  header body 