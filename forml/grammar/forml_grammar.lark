%import common.WS
%import common.WS_INLINE
%import common.NEWLINE
%import common.ESCAPED_STRING
%import common.NUMBER
%import common.DIGIT
%ignore WS_INLINE

# === OFFICIAL PROBLEMS ===
CLASSIFICATION : "CLASSIFICATION"
PREDICTION : "PREDICTION"
REGRESSION : "REGRESSION"
CLUSTERING : "CLUSTERING"
ANOMALY_DETECTION : "ANOMALY_DETECTION"
REINFORCEMENT_LEARNING : "REINFORCEMENT_LEARNING"

# === OFFICIAL PROPERTIES ===
ROBUSTNESS : "ROBUSTNESS"
STABILITY : "STABILITY"
FAIRNESS : "FAIRNESS"
MONOTONICITY : "MONOTONICITY"
BOUND : "BOUND"
LOGIC : "LOGIC"

# === OFFICIAL QUANTIFIER SETS ===
FORALL : "∀"
EXISTS : "∃"
forall : "forall"
exists : "exists"

# === OFFICIAL FUNCTIONS ===
EQUAL : "EQUAL"
EQUITY : "EQUITY"
BETWEEN : "BETWEEN"
INCREASING : "INCREASING"

# === OFFICIAL BACKENDS ===
eran : "eran"
ERAN : "ERAN"
zonotope : "zonotope"
ZONOTOPE : "ZONOTOPE"
box : "box"
BOX : "BOX"
z3 : "z3"
Z3 : "Z3"

# === OFFICIAL SETS ===
ball : "ball"
hyperball : "hyperball"
noise : "noise"

# === BASIC CHARACTER DEFINITIONS ===
CHAR :
    /[a-zA-Z]/ ;

# === BASIC VALUE TYPES ===
true :
    "True"
    | "true"

false :
    "False"
    | "false"

boolean :
    true
    | false

# === IDENTIFIERS ===
identifier :*
    /[A-Za-z][A-Za-z0-9_.] / ;
quoted_identifier :
    ESCAPED_STRING
    | identifier

# === VALUE TYPES ===
value_identifier :
    quoted_identifier ;
value_number :
    NUMBER ;
value_boolean :
    boolean ;
value :
    value_identifier
    | value_number
    | value_boolean

# === ARGUMENTS ===
arg_identifier_eq :
    quoted_identifier "=" value ;
arg_identifier_only :
    quoted_identifier ;
arg_number :
    NUMBER ;
arg_boolean :
    boolean ;
arg :
    arg_identifier_eq
    | arg_identifier_only
    | arg_number
    | arg_boolean
args :
    arg
    (
        "," arg
    )* ;

# === SEPARATOR DEFINITIONS ===
SEPARATOR :
    ";" ;

# === NEWLINE DEFINITIONS ===
NEWLINES :
    NEWLINE
    (
        NEWLINE
    )* ;

# === PROGRAM STRUCTURE ===
# === PROGRAM COMPONENTS ===

# === COMMENTS ===
simple_comment :
    "#" /[^\n]+/ ;
multiline_comment :
    /'''(.
    | \n)*?'''/
comment :
    simple_comment
    | multiline_comment
comments :
    comment
    (
        comment
    )* ;

# === DECLARATION SECTION ===
declaration_section :
    identifier ":=" value ;

# === PROPERTY SECTION ===
logic_connection :
    "AND"
    | "OR"

logic_operation :
    "=="
    | "!="
    | "<"
    | "<="
    | ">"
    | ">="

logic_expr :
    (
        "NOT"
    )?
    identifier logic_operation value ;
logic_implication :  "(" logic_expr "->" logic_expr ")" 
logic_assertion :
    logic_implication
    (
        logic_connection logic_implication
    )* ;


function :
    ( EQUAL
    | EQUITY
    | BETWEEN
    | INCREASING )
function_expr :  function "(" ( args )? ")" 
problem_expr :
    ( CLASSIFICATION
    | PREDICTION
    | REGRESSION
    | CLUSTERING
    | ANOMALY_DETECTION
    | REINFORCEMENT_LEARNING ) "." function_expr

assertion :
    problem_expr
    | logic_assertion

# === PROPERTY EXPRESSION OPTIONS ===
property_expr :
    universal_expr
    | anchor_expr
    | check_expr
    | pairwise_expr

quantifier :
    ( FORALL
    | EXISTS
    | forall
    | exists ) ( identifier )? "in"

# === UNIVERSAL EXPRESSIONS ===
universal_set :  ( ball | hyperball | noise ) "(" ( args )? ")" 
universal_expr :
    quantifier universal_set ;

# === ANCHOR EXPRESSIONS ===
domain :  "with" identifier "(" value ( "," value )* ")" 
anchor_expr :
    "at" identifier
    (
        "in" universal_expr
    )?
    (
        domain
    )? ;

# === CHECK EXPRESSIONS ===
check_expr :
    "check_at" identifier ;

# === PAIRWISE EXPRESSIONS ===
symbolic_distance :  "distance" "(" identifier "," identifier "," value ")" 

pairwise_expr :
    identifier "~" identifier "with" symbolic_distance ;

# === PROPERTY DEFINITION ===
property_type :
    ( ROBUSTNESS
    | STABILITY
    | FAIRNESS
    | MONOTONICITY
    | BOUND
    | LOGIC )
    | /[A-Z]+/

property :
    "[" property_type "]" ":" NEWLINE property_expr "->" assertion ;

property_section :
    property
    (
        abstractor
    )? ;

# === SECTION DEFINITION ===
section :
    ( comments )* ( declaration_section
    | property_section )

# === ABSTRACTOR SECTION ===
abstractor :  "using" ( eran | ERAN | zonotope | ZONOTOPE | box | BOX | z3 | Z3 ) ( "(" ( args )* ")" )? 

# === TARGET DECLARATION ===
target_declaration :
    "target" ":=" identifier ;

# === MODEL DECLARATION ===
model :
    quoted_identifier ;

model_declaration :
    "model" ":=" model ;

# === FULL PROGRAM ===
header :
    (
        NEWLINES
    )*
    (
        comments
    )*
    (
        NEWLINES
    )*
    (
        model_declaration
    )?
    (
        target_declaration
    )? ;

body :
    (
        NEWLINES
    )*
    section
    (
        SEPARATOR section
    )* ;

footer :
    ( comments
    | NEWLINES )*

program :
    header body footer ;