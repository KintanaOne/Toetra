(* === BASIC CHARACTER DEFINITIONS === *)
CHAR = ? CHAR ?;

(* === BASIC VALUE TYPES === *)
true  = "True" | "true" ;
false = "False" | "false" ;
boolean = true | false ;

(* === IDENTIFIERS === *)
identifier = ? identifier_name ? ;
quoted_identifier = ? escaped_string ? | identifier ;

(* === VALUE TYPES === *)
value_identifier = quoted_identifier ;
value_number = ? number ? ;
value_boolean = boolean ;
value = value_identifier | value_number | value_boolean ;

(* === ARGUMENTS === *)
arg_identifier_eq   = quoted_identifier , "=" , value ;
arg_identifier_only = quoted_identifier ;
arg_number          = ? number ? ;
arg_boolean         = boolean ;

arg  = arg_identifier_eq | arg_identifier_only | arg_number | arg_boolean ;
args = arg , { "," , arg } ;

(* === SEPARATORS === *)
SEPARATOR = ";" ;

(* === NEWLINES === *)
NEWLINE_SEQUENCE = NEWLINE , { NEWLINE } ;

(* === COMMENTS === *)
simple_comment     = "#" , ? any_character_except_newline ? ;
multiline_comment  = ? any_character_except_triple_quotes ? ;
comment            = simple_comment | multiline_comment ;
comments           = comment , { comment } ;

(* === PADDING === *)
padding = { NEWLINE_SEQUENCE | comments } ;

(* ========================================================= *)
(* === LOGIC (NON-ROBUSTNESS) =============================== *)
(* ========================================================= *)

logic_connection = "AND" | "OR" ;
logic_operation  = "==" | "!=" | "<" | "<=" | ">" | ">=" ;

logic_expr =
    [ "NOT" ] , identifier , logic_operation , value ;

logic_implication =
    "(" , logic_expr , "->" , logic_expr , ")" ;

logic_assertion =
    logic_implication , { logic_connection , logic_implication } ;

(* === FUNCTIONS / PROBLEMS === *)
function        = ? official_functions ? ;
function_expr   = function , "(" , [ args ] , ")" ;
problem_expr    = ? official_problems ? , "." , function_expr ;

assertion = problem_expr | logic_assertion ;

(* ========================================================= *)
(* === ROBUSTNESS CORE ===================================== *)
(* ========================================================= *)

(* === NEIGHBORHOOD (CRITICAL ABSTRACTION) === *)
neighborhood =
    ? official_neighborhoods ? , "(" , identifier , "," , [ args ] , ")" ;

(* Exemple attendu :
   hyperball(x, "L2", 0.01)
*)

(* ========================================================= *)
(* === PROPERTY EXPRESSIONS ================================ *)
(* ========================================================= *)

property_expr =
      quantifier_expr
    | at_expr
    | check_expr
    | pairwise_expr ;

(* === UNIVERSAL (GLOBAL) === *)
quantifier = ? official_quantifier ? ;

quantifier_expr =
    quantifier , [ domain ] ;

(* Exemple :
   forall -> P()
   (x implicite)
*)

(* ================================== POINTWISE ================================== *)

(* ========================================================= *)
(* === AT (POINTWISE) ====================================== *)
(* ========================================================= *)

at_expr =
    "at" , identifier ,
    [ "in" , neighborhood ] , [ domain ] ;

(* Exemple :
   at x0 in hyperball(x0, L2, 0.01)
*)

(* ========================================================= *)
(* === CHECK AT (POINTWISE) ================================ *)
(* ========================================================= *)

check_expr =
    "check_at" , identifier ;

(* ========================================================= *)
(* === PAIRWISE (ROBUSTNESS) =============================== *)
(* ========================================================= *)

pairwise_expr =
    identifier , "~" , identifier ,
    "in" , neighborhood ;

(* Exemple :
   x ~ x' in hyperball(x, L2, 0.01)
*)

(* ========================================================= *)
(* === DOMAIN / CONTEXT ==================================== *)
(* ========================================================= *)

domain =
    "with" , identifier ,
    "(" , value , { "," , value } , ")" ;

(* ========================================================= *)
(* === PROPERTY DEFINITION ================================= *)
(* ========================================================= *)

property_type =
    ? official_properties ? | ? uppercase_string ? ;

property =
    "[" , property_type , "]" , ":" ,
    property_expr , "->" , assertion ;

property_section =
    property , [ abstractor ] ;

(* ========================================================= *)
(* === ABSTRACTOR ========================================== *)
(* ========================================================= *)

abstractor =
    "using" , ? official_backends ? ,
    [ "(" , args , ")" ] ;

(* ========================================================= *)
(* === DECLARATIONS ======================================== *)
(* ========================================================= *)

target_declaration =
    "target" , ":=" , identifier ;

model =
    quoted_identifier ;

model_declaration =
    "model" , ":=" , model ;

variable_declaration =
    identifier , ":=" , value ;

variables_declaration =
    variable_declaration ,
    { SEPARATOR | padding , variable_declaration } ;

(* ========================================================= *)
(* === PROGRAM STRUCTURE =================================== *)
(* ========================================================= *)

header =
    padding ,
    model_declaration ,
    padding ,
    target_declaration ,
    padding ,
    [ variables_declaration , padding ] ;

body =
    padding ,
    property_section ,
    { SEPARATOR , padding , property_section } ,
    [ SEPARATOR ] ,
    padding ;

program =
    header , body ;