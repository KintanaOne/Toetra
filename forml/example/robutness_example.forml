target := MyTargetColumn

# 1 forall without using
[ROBUTNESS]:
forall in hyperball("L2", 0.01) -> CLASSIFICATION.EQUAL()

[ROBUTNESS]:
forall in hyperball("L2", 0.01) -> PREDICTION.EQUAL()

# 2 forall and using simple
[ROBUTNESS]:
forall in hyperball("L2", 0.01) -> CLASSIFICATION.EQUAL() using eran

[ROBUTNESS]:
forall in hyperball("L2", 0.01) -> PREDICTION.EQUAL() using eran

# 3 forall and using with parameters
[ROBUTNESS]:
forall in hyperball("L2", 0.01) -> CLASSIFICATION.EQUAL() using eran(param1="a")

[ROBUTNESS]:
forall in hyperball("L2", 0.01) -> PREDICTION.EQUAL() using eran(param1="a")

# 4 at without using
[ROBUTNESS]:
at x0 in hyperball(L_type="L2", ops=0.01) -> CLASSIFICATION.EQUAL()

[ROBUTNESS]:
at x0 in hyperball(L_type="L2", ops=0.01) -> PREDICTION.EQUAL()

# 5 at and using simple
[ROBUTNESS]:
at x0 in hyperball(L_type="L2", ops=0.01) -> CLASSIFICATION.EQUAL() using eran

[ROBUTNESS]:
at x0 in hyperball(L_type="L2", ops=0.01) -> PREDICTION.EQUAL() using eran

# 6 at and using with parameters
[ROBUTNESS]:
at x0 in hyperball(L_type="L2", ops=0.01) -> CLASSIFICATION.EQUAL(threshold=0.1) using eran(param1="a")

[ROBUTNESS]:
at x0 in hyperball(L_type="L2", ops=0.01) -> PREDICTION.EQUAL(threshold=0.1) using eran(param1="a")

# 7 check_at without using
[ROBUTNESS]:
check_at x0 -> CLASSIFICATION.EQUAL()

[ROBUTNESS]:
check_at x0 -> PREDICTION.EQUAL()

# 8 check_at and using simple
[ROBUTNESS]:
check_at x0 -> CLASSIFICATION.EQUAL() using eran

[ROBUTNESS]:
check_at x0 -> PREDICTION.EQUAL() using eran

# 9 check_at and using with parameters
[ROBUTNESS]:
check_at x0 -> CLASSIFICATION.EQUAL() using eran(param1="a", param2=42)

[ROBUTNESS]:
check_at x0 -> PREDICTION.EQUAL() using eran(param1="a", param2=42)
