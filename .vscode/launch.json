{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run FORML file (fixed env)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",

            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },

            "justMyCode": true
        }
    ]
}